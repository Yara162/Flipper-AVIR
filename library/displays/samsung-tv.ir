Filetype: IR signals file
Version: 1
# Brand: Samsung
# Models: Consumer and commercial TVs using the Samsung32 code set (address 07)
# Source: Samsung's published NEC-style codes (E0E0xxxx), decoded to Flipper's Samsung32 form
# Tested: no
# Notes: Power_on and Power_off are discrete codes; commercial displays may also need RS-232 or MDC for remote lockout.
#
name: Power
type: parsed
protocol: Samsung32
address: 07 00 00 00
command: 02 00 00 00
#
name: Power_on
type: parsed
protocol: Samsung32
address: 07 00 00 00
command: 99 00 00 00
#
name: Power_off
type: parsed
protocol: Samsung32
address: 07 00 00 00
command: 98 00 00 00
